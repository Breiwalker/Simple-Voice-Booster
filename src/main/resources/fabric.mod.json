{
  "schemaVersion": 1,
  "id": "simple_voice_booster",
  "version": "${version}",
  "name": "Simple Voice Booster",
  "description": "Raises the Simple Voice Chat microphone amplification limit with a configurable boost (up to 20000%) and optional AGC / clipping overrides.",
  "authors": [
    "Breiwalker"
  ],
  "contact": {
    "homepage": "https://github.com/Breiwalker/Simple-Voice-Booster",
    "sources": "https://github.com/Breiwalker/Simple-Voice-Booster",
    "issues": "https://github.com/Breiwalker/Simple-Voice-Booster/issues"
  },
  "license": "All-Rights-Reserved",
  "icon": "assets/simple_voice_booster/icon.png",
  "environment": "client",
  "entrypoints": {
    "fabric-datagen": [
      "dev.breiwalker.simple_voice_booster.client.Simple_voice_boosterDataGenerator"
    ],
    "client": [
      "dev.breiwalker.simple_voice_booster.client.Simple_voice_boosterClient"
    ],
    "main": [
      "dev.breiwalker.simple_voice_booster.Simple_voice_booster"
    ],
    "voicechat": [
      "dev.breiwalker.simple_voice_booster.SimpleVoiceBoosterPlugin"
    ],
    "modmenu": [
      "dev.breiwalker.simple_voice_booster.client.SimpleVoiceBoosterModMenu"
    ]
  },
  "mixins": [
    "simple_voice_booster.mixins.json",
    {
      "config": "simple_voice_booster.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": ">=26.1",
    "voicechat": ">=2.6.24"
  },
  "suggests": {
    "modmenu": ">=21.0.0"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.source": "https://github.com/Breiwalker/Simple-Voice-Booster",
        "modmenu.issues": "https://github.com/Breiwalker/Simple-Voice-Booster/issues"
      }
    }
  }
}
